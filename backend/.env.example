# ==========================================
# eRTMAC NWIS Backend Environment Variables
# ==========================================

# LLM Provider Configuration
# Options: "mock", "openai", "anthropic", "google"
# Leave as "mock" or empty to use the deterministic deterministic mock engine
LLM_PROVIDER=mock

# API Key for the chosen LLM provider (not needed if LLM_PROVIDER=mock)
LLM_API_KEY=your_api_key_here

# Database URL
# Uses SQLite for the local demo. For production, switch to PostgreSQL.
DATABASE_URL=sqlite:///./nwis.db

# CORS Configuration
# Comma-separated list of allowed origins (e.g., http://localhost:5174)
CORS_ORIGINS=*
